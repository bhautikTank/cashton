// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PayoutMethod {
  BANK
  UPI
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REJECTED
}

enum PayoutVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CashbackStatus {
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
  REVERSED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ClickStatus {
  TRACKED
  REDIRECTED
  FAILED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REVERSAL
  ADJUSTMENT
}

enum WalletTransactionCategory {
  CASHBACK
  PAYOUT
  ADMIN_ADJUSTMENT
  BONUS
  CASHBACK_HELD
  HOLD_RELEASED
  REVERSAL_FROM_HELD
  REVERSAL_FROM_AVAILABLE
  DEBT_CREATED
  DEBT_RECOVERED
  DEBT_WRITTEN_OFF
  PAYOUT_REFUND
}

enum CashbackDebtStatus {
  OPEN
  UNDER_REVIEW
  DISPUTED
  RECOVERED
  WRITTEN_OFF
}

enum AffiliateProvider {
  FLIPKART
  CUELINKS
  ADMITAD
  EARNKARO
  GENERIC
}

enum CampaignShareType {
  PERCENTAGE
  FIXED
}

enum ConversionStatus {
  PENDING
  APPROVED
  CONFIRMED
  REJECTED
  REVERSED
  UNMATCHED
  NEEDS_CAMPAIGN_RULE
}

model User {
  id           String   @id @default(uuid())
  authUserId   String   @unique
  name         String?
  email        String   @unique
  mobileNumber String?  @unique
  passwordHash String?
  role         UserRole @default(USER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payoutDetails   PayoutDetails?
  cashbacks       Cashback[]
  wallet          Wallet?
  affiliateClicks AffiliateClick[]
  conversions     Conversion[]
  debts           CashbackDebt[]   @relation("UserDebts")
  resolvedDebts   CashbackDebt[]   @relation("AdminDebtResolutions")
  payouts         Payout[]
  processedPayouts Payout[]        @relation("AdminPayoutProcessing")
}

model Merchant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  websiteUrl  String?
  logoUrl     String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cashbacks       Cashback[]
  deals           Deal[]
  coupons         Coupon[]
  affiliateClicks AffiliateClick[]
  conversions     Conversion[]
  campaigns       Campaign[]

  @@index([isActive])
  @@index([createdAt])
}

model PayoutDetails {
  id                     String                   @id @default(uuid())
  userId                 String                   @unique
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountHolderName      String?
  encryptedAccountNumber String?
  accountNumberLast4     String?
  ifscCode               String?
  bankName               String?
  upiId                  String?
  payoutMethod           PayoutMethod             @default(UPI)
  status                 PayoutVerificationStatus @default(PENDING)

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([userId])
}

model Cashback {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId          String?
  merchant            Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  amount              Decimal            @db.Decimal(10, 2)
  status              CashbackStatus     @default(PENDING)
  externalReferenceId String?            @unique
  description         String?
  rejectionReason     String?
  approvedAt          DateTime?
  confirmedAt         DateTime?

  heldAmount          Decimal            @default(0.00) @db.Decimal(10, 2)
  heldUntil           DateTime?
  holdReleased        Boolean            @default(false)
  reversedAmount      Decimal            @default(0.00) @db.Decimal(10, 2)

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  walletTransactions  WalletTransaction[]
  conversion          Conversion?
  debts               CashbackDebt[]

  @@index([userId])
  @@index([status])
  @@index([merchantId])
  @@index([createdAt])
  @@index([heldUntil, holdReleased])
}

model Wallet {
  id               String              @id @default(uuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance          Decimal             @default(0.00) @db.Decimal(10, 2)
  availableBalance Decimal             @default(0.00) @db.Decimal(10, 2)
  heldBalance      Decimal             @default(0.00) @db.Decimal(10, 2)
  debtBalance      Decimal             @default(0.00) @db.Decimal(10, 2)

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  transactions     WalletTransaction[]
  debts            CashbackDebt[]
  payouts          Payout[]

  @@index([userId])
}

model WalletTransaction {
  id             String                    @id @default(uuid())
  walletId       String
  wallet         Wallet                    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Decimal                   @db.Decimal(10, 2)
  type           WalletTransactionType
  category       WalletTransactionCategory
  idempotencyKey String?                   @unique
  description    String
  cashbackId     String?
  cashback       Cashback?                 @relation(fields: [cashbackId], references: [id], onDelete: SetNull)
  debtId         String?
  debt           CashbackDebt?             @relation(fields: [debtId], references: [id], onDelete: SetNull)
  payoutId       String?
  payout         Payout?                   @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  createdAt      DateTime                  @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@index([cashbackId])
  @@index([debtId])
  @@index([payoutId])
}

model Deal {
  id            String    @id @default(uuid())
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title         String
  slug          String    @unique
  description   String?
  imageUrl      String?
  originalPrice Decimal?  @db.Decimal(10, 2)
  dealPrice     Decimal?  @db.Decimal(10, 2)
  affiliateUrl  String?
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  affiliateClicks AffiliateClick[]
  conversions     Conversion[]
  campaigns       Campaign[]

  @@index([merchantId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model Coupon {
  id              String       @id @default(uuid())
  merchantId      String
  merchant        Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title           String
  code            String
  description     String?
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  minimumPurchase Decimal?     @db.Decimal(10, 2)
  maximumDiscount Decimal?     @db.Decimal(10, 2)
  usageLimit      Int?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([merchantId, code])
  @@index([code])
  @@index([merchantId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model AffiliateClick {
  id                 String       @id @default(uuid())
  clickId            String       @unique
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  dealId             String
  deal               Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict)
  merchantId         String
  merchant           Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  clickedAt          DateTime     @default(now())
  source             String?
  landingDestination String
  status             ClickStatus  @default(TRACKED)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  conversions        Conversion[]

  @@index([clickId])
  @@index([userId, clickedAt])
  @@index([dealId, clickedAt])
  @@index([merchantId, clickedAt])
  @@index([status, clickedAt])
}

model Conversion {
  id                    String            @id @default(uuid())
  provider              AffiliateProvider
  externalTransactionId String
  affiliateClickId      String?
  affiliateClick        AffiliateClick?   @relation(fields: [affiliateClickId], references: [id], onDelete: SetNull)
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  merchantId            String?
  merchant              Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  dealId                String?
  deal                  Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  cashbackId            String?           @unique
  cashback              Cashback?         @relation(fields: [cashbackId], references: [id], onDelete: SetNull)
  campaignId            String?
  campaign              Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  shareType             CampaignShareType?
  userShareValue        Decimal?          @db.Decimal(10, 2)

  orderAmount           Decimal           @db.Decimal(10, 2)
  commissionAmount      Decimal           @db.Decimal(10, 2)
  cashbackAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  reversedAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  currency              String            @default("INR")
  status                ConversionStatus  @default(PENDING)

  convertedAt           DateTime          @default(now())
  rawPayload            Json?
  campaignSnapshot      Json?
  reconciliationNotes   String?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  debts                 CashbackDebt[]

  @@unique([provider, externalTransactionId])
  @@index([provider, externalTransactionId])
  @@index([affiliateClickId])
  @@index([userId])
  @@index([merchantId])
  @@index([dealId])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model Campaign {
  id                  String             @id @default(uuid())
  name                String
  description         String?
  merchantId          String?
  merchant            Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  dealId              String?
  deal                Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  network             AffiliateProvider?
  shareType           CampaignShareType  @default(PERCENTAGE)
  userShareValue      Decimal            @db.Decimal(10, 2)
  maxCashbackPerOrder Decimal?           @db.Decimal(10, 2)
  maxCashbackPerUser  Decimal?           @db.Decimal(10, 2)
  maxCampaignBudget   Decimal?           @db.Decimal(10, 2)
  minOrderAmount      Decimal?           @db.Decimal(10, 2)
  startDate           DateTime?
  endDate             DateTime?
  isActive            Boolean            @default(true)
  priority            Int                @default(0)
  createdByAdminId    String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  conversions         Conversion[]

  @@index([merchantId])
  @@index([dealId])
  @@index([network])
  @@index([isActive])
  @@index([priority])
  @@index([createdAt])
}

model CashbackDebt {
  id                      String             @id @default(uuid())
  walletId                String
  wallet                  Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  userId                  String
  user                    User               @relation("UserDebts", fields: [userId], references: [id], onDelete: Restrict)
  amount                  Decimal            @db.Decimal(10, 2)
  remainingAmount         Decimal            @db.Decimal(10, 2)
  status                  CashbackDebtStatus @default(OPEN)
  idempotencyKey          String?            @unique
  originatingCashbackId   String?
  originatingCashback     Cashback?          @relation(fields: [originatingCashbackId], references: [id], onDelete: Restrict)
  originatingConversionId String?
  originatingConversion   Conversion?        @relation(fields: [originatingConversionId], references: [id], onDelete: Restrict)
  reason                  String?
  resolvedByAdminId       String?
  resolvedByAdmin         User?              @relation("AdminDebtResolutions", fields: [resolvedByAdminId], references: [id], onDelete: Restrict)
  resolvedAt              DateTime?
  notes                   String?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  transactions            WalletTransaction[]

  @@index([walletId, status])
  @@index([userId])
  @@index([status])
  @@index([resolvedByAdminId])
}

model Payout {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId           String
  wallet             Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  amount             Decimal       @db.Decimal(10, 2)
  status             PayoutStatus  @default(PENDING)
  payoutMethod       PayoutMethod  @default(UPI)
  destinationMasked  String?
  provider           String        @default("MANUAL")
  providerReference  String?
  idempotencyKey     String?       @unique
  failureReason      String?
  processedByAdminId String?
  processedByAdmin   User?         @relation("AdminPayoutProcessing", fields: [processedByAdminId], references: [id], onDelete: Restrict)
  processedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  transactions       WalletTransaction[]

  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
  @@index([processedByAdminId])
}
